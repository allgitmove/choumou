<Border xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Name="Frame" Background="#FAFAFC" BorderBrush="#D9D9E0" BorderThickness="1" CornerRadius="16" Margin="12">
 <Border.Effect><DropShadowEffect BlurRadius="22" ShadowDepth="5" Opacity="0.16" Color="#303044"/></Border.Effect>
 <Border.Resources>
  <SolidColorBrush x:Key="Ink" Color="#25252B"/>
  <SolidColorBrush x:Key="Muted" Color="#85858F"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Ink}"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="Button">
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Padding" Value="15,8"/><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#38383F"/><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#DCDCE3"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="ButtonSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"><ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.8"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.6"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="#007AFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#007AFF"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#0070EB"/></Style>
  <Style x:Key="Traffic" TargetType="Button"><Setter Property="Width" Value="13"/><Setter Property="Height" Value="13"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="7" BorderBrush="#22000000" BorderThickness="0.7"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" x:Name="Glyph"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Glyph" Property="Opacity" Value="0.65"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Group" TargetType="Border"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#E3E3E9"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/></Style>
  <Style TargetType="Slider"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24"><Border Height="4" Background="#E1E1E8" CornerRadius="2" VerticalAlignment="Center"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate><Border Height="4" Background="#007AFF" CornerRadius="2" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate><Ellipse Fill="White" Stroke="#CBCBD3" StrokeThickness="0.8"><Ellipse.Effect><DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.15"/></Ellipse.Effect></Ellipse></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Border.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#EEEEF3" CornerRadius="15,0,0,15" BorderBrush="#DCDCE3" BorderThickness="0,0,1,0">
   <Grid><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
    <Grid x:Name="SideHeader" Background="Transparent"><StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0"><Button x:Name="CloseButton" Style="{StaticResource Traffic}" Background="#FF5F57" Content="×" ToolTip="关闭"/><Button x:Name="MinButton" Style="{StaticResource Traffic}" Background="#FEBC2E" Content="−" ToolTip="最小化"/><Button x:Name="MaxButton" Style="{StaticResource Traffic}" Background="#28C840" Content="+" ToolTip="最大化 / 还原"/></StackPanel></Grid>
    <StackPanel Grid.Row="1" Margin="15,18,15,0">
     <StackPanel Orientation="Horizontal" Margin="9,0,0,28"><Image x:Name="BrandIcon" Width="34" Height="34"/><StackPanel Margin="10,-2,0,0"><TextBlock Text="绸缪" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="Choumou" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel></StackPanel>
     <TextBlock Text="资料库" FontSize="10" FontWeight="SemiBold" Foreground="#94949E" Margin="11,0,0,9"/>
     <Border Background="#DDDFE8" CornerRadius="7" Padding="12,10"><StackPanel Orientation="Horizontal"><TextBlock Text="▣" Foreground="#007AFF" FontSize="15" Margin="0,0,10,0"/><TextBlock Text="启动动画" FontWeight="SemiBold"/></StackPanel></Border>
     <TextBlock Text="一段影片，一次全新开场。" FontSize="10" Foreground="#9999A4" Margin="11,17,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="2" Margin="25,0,15,20" VerticalAlignment="Bottom"><StackPanel Orientation="Horizontal"><Ellipse Fill="#34C759" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="本地运行" FontSize="11" Foreground="#6D6D78"/></StackPanel><TextBlock Text="Choumou · 为登场加一点仪式感" FontSize="10" Foreground="#A1A1AB" Margin="13,7,0,0"/></StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="64"/><RowDefinition Height="*"/><RowDefinition Height="74"/></Grid.RowDefinitions>
   <Grid x:Name="Header" Background="Transparent" Margin="28,0"><TextBlock Text="启动动画" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock Text="PERSONALIZE YOUR OPENING" Foreground="#A1A1AA" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="28,4,28,20">
    <TextBlock Text="每次启动，都值得期待。" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,7"/>
    <TextBlock Text="选择喜欢的影片，让 Codex 以你的方式登场。" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,0,20"/>
    <Border CornerRadius="12" Height="175" BorderBrush="#E1DEEB" BorderThickness="1"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8E8FC"/><GradientStop Color="#EDF1FA" Offset="0.55"/><GradientStop Color="#F5E9EE" Offset="1"/></LinearGradientBrush></Border.Background><Grid><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"><Border Width="43" Height="43" Background="#BFFFFFFF" CornerRadius="22" Margin="0,0,0,10"><TextBlock Text="▷" FontSize="27" Foreground="#7775AD" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="VideoName" Text="把喜欢的画面，放在开场。" FontSize="15" FontWeight="SemiBold" Foreground="#57566C" TextAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="440"/><TextBlock Text="拖入 MP4 · 让故事从这里开始" Foreground="#9390A6" FontSize="11" TextAlignment="Center" Margin="0,7,0,0"/></StackPanel><TextBlock Text="YOUR NEXT OPENING" FontSize="8" Foreground="#AAA6B9" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="0,0,15,12"/></Grid></Border>
    <DockPanel Margin="0,12,0,21"><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button x:Name="ImportButton" Content="导入 MP4…" Margin="0,0,8,0"/><Button x:Name="PreviewButton" Content="▷  预览"/></StackPanel><TextBlock x:Name="VideoMeta" Text="尚未添加影片" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></DockPanel>
    <TextBlock Text="播放" Foreground="#7C7C87" FontSize="11" FontWeight="SemiBold" Margin="2,0,0,8"/>
    <Border Style="{StaticResource Group}"><StackPanel>
     <Grid Margin="16,11"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="180"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBlock Text="影片音量" VerticalAlignment="Center"/><Slider x:Name="Volume" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center"/><TextBlock x:Name="VolumeLabel" Grid.Column="2" Text="50%" FontSize="11" Foreground="{StaticResource Muted}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
     <Border Background="#EDEDF2" Height="1" Margin="16,0,0,0"/>
     <Grid Margin="16,12"><StackPanel><TextBlock Text="全屏播放"/><TextBlock Text="铺满屏幕，边缘可能轻微裁切" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><CheckBox x:Name="Fullscreen" HorizontalAlignment="Right" VerticalAlignment="Center" ToolTip="全屏播放"><CheckBox.Template><ControlTemplate TargetType="CheckBox"><Border x:Name="SwitchTrack" Background="#D8D8E0" Width="34" Height="20" CornerRadius="10"><Ellipse x:Name="SwitchThumb" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2"/></Border><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="SwitchTrack" Property="Background" Value="#34C759"/><Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#007AFF"/><Setter TargetName="SwitchTrack" Property="BorderThickness" Value="1"/></Trigger></ControlTemplate.Triggers></ControlTemplate></CheckBox.Template></CheckBox></Grid>
    </StackPanel></Border>
    <Expander Header="启动应用" IsExpanded="False" Foreground="#777782" FontSize="11" Margin="2,17,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="已预填本机 Codex；需要时也可选择其他应用。" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,8"/><DockPanel><Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="选择 EXE…" Margin="8,0,0,0"/><TextBox x:Name="Target" FontSize="11" Padding="8" Background="White" Foreground="#555560" BorderBrush="#DCDCE4" BorderThickness="1" VerticalContentAlignment="Center"/></DockPanel></StackPanel></Expander>
    <StackPanel Orientation="Horizontal" Margin="2,15,0,0"><Button x:Name="IntegrateButton" Content="接入 Codex 图标" Margin="0,0,8,0"/><Button x:Name="RestoreButton" Content="恢复原图标"/></StackPanel><TextBlock Text="接入后，点击原来的桌面图标即可播放。" FontSize="10" Foreground="#9999A4" Margin="2,8,0,0"/><TextBlock x:Name="Notice" TextWrapping="Wrap" FontSize="11" Foreground="#888893" Margin="2,16,0,0"/>
   </StackPanel></ScrollViewer>
   <Border Grid.Row="2" BorderBrush="#E5E5EB" BorderThickness="0,1,0,0" Padding="28,0"><DockPanel LastChildFill="False"><Button x:Name="StartButton" DockPanel.Dock="Right" Content="播放并启动 Codex  →" Style="{StaticResource Primary}" VerticalAlignment="Center"/><Button x:Name="SaveButton" DockPanel.Dock="Left" Content="保存设置" VerticalAlignment="Center"/></DockPanel></Border>
  </Grid>
 </Grid>
</Border>
